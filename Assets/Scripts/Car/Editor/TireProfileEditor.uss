.tire-preview {
    margin-top: 8px;
}

.tire-preview-header {
    -unity-font-style: bold;
    margin-top: 6px;
}

.tire-graph {
    height: 140px;
    margin-top: 2px;
    margin-bottom: 2px;
    background-color: rgba(0, 0, 0, 0.12);
    overflow: hidden;
}

.tire-preview-caption {
    white-space: normal;
}

.tire-preview-legend {
    white-space: normal;
    margin-top: 6px;
    opacity: 0.7;
}
